#!/usr/bin/env bash
# Abre a barra do Claude Rápido. É o que o atalho global chama: na primeira vez sobe o
# app; depois o app já está rodando e essa chamada só faz a janela aparecer.
#   claude-rapido            mostra a barra
#   claude-rapido --oculto   sobe o app escondido (usado no início da sessão)
RAIZ="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
exec "$RAIZ/node_modules/electron/dist/electron" "$RAIZ" --ozone-platform=x11 "$@"
